VITE_API_URL=http://localhost:3000
# The shop's help WhatsApp number (country code and number, digits only). Required for a
# production shop build (npm run shop:build); dev servers work without it.
VITE_SUPPORT_WHATSAPP=
# Browser errors to Sentry (deploy/VERCEL.md, "Error reports from the shop and the panel").
# Leave empty locally: then there are no reports and no Sentry code in the build. The panel
# and the shop each have their own Sentry project and DSN (the shop reads customer-app/.env).
VITE_SENTRY_DSN=
# Optional: the environment tag. Unset, it is Vercel's environment, else the Vite mode.
VITE_SENTRY_ENVIRONMENT=
# Optional, for readable stack traces: with all three set, the build uploads its source maps
# to Sentry and then deletes them. Set them in Vercel, not here; never commit the token.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
