VITE_API_URL=http://localhost:3000
# Browser errors to Sentry (deploy/VERCEL.md, "Error reports from the shop and the panel").
# Leave empty locally: then there are no reports and no Sentry code in the build. The panel
# and the shop each have their own Sentry project and DSN.
VITE_SENTRY_DSN=
# Optional: the environment tag. Unset, it is Vercel's environment, else the Vite mode.
VITE_SENTRY_ENVIRONMENT=
# Optional, for readable stack traces: with all three set, the build uploads its source maps
# to Sentry and then deletes them. Set them in Vercel, not here; never commit the token.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# The shop (shop/): read by `node shop/build-config.mjs` (npm run shop:build), which writes
# shop/config.js. Unset, the API is http://localhost:3000 (refused in a Vercel production build).
API_URL=http://localhost:3000
# Optional: the support WhatsApp number shown in the shop (digits with country code, e.g. 919800000000).
SUPPORT_WHATSAPP=
