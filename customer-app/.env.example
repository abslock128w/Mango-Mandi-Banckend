# The shop (Next.js). Copy to customer-app/.env.local for local runs; start-local.mjs sets these itself.
# mango-api's address; the shop calls its /v1 storefront API.
NEXT_PUBLIC_API_URL=http://localhost:3000
# The shop's help WhatsApp number (country code and number, digits only). Required for a
# production build (npm run shop:build); dev servers work without it.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
# Optional: Google Maps for the location picker (OpenStreetMap is used without it).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
