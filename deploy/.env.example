# Production settings. Copy to deploy/.env on the server (never commit it) and fill in.
# The API refuses to start while a required value is missing or a dev default.

# --- Domains (DNS A records for all three point at this server) ---
SHOP_DOMAIN=example.in
ADMIN_DOMAIN=admin.example.in
API_DOMAIN=api.example.in
# Let's Encrypt sends certificate expiry notices here
ACME_EMAIL=

# --- Secrets: generate each with  openssl rand -hex 32 ---
POSTGRES_PASSWORD=
JWT_SECRET=
# Bearer token for /metrics if you scrape it from outside the server
METRICS_TOKEN=

# --- First manager for the staff panel (used once, when there are no staff yet) ---
ADMIN_BOOTSTRAP_EMAIL=
# 12+ characters; change it from the Staff page after the first sign-in
ADMIN_BOOTSTRAP_PASSWORD=

# --- Razorpay (Dashboard > Account & Settings > API keys; live mode) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks: URL https://<API_DOMAIN>/webhooks/razorpay, events payment.authorized, payment.captured,
# payment.failed, payment_link.paid, refund.processed and refund.failed. Paste the secret you set there.
RAZORPAY_WEBHOOK_SECRET=

# --- Login codes by SMS through Jio (DLT registration) ---
SMS_PROVIDER=jio
JIO_SMS_URL=
JIO_SMS_API_KEY=
# 6-character DLT header, e.g. MANDIM
JIO_SMS_SENDER_ID=
JIO_SMS_TEMPLATE_ID=
JIO_SMS_ENTITY_ID=
# Must match the DLT template word for word
JIO_SMS_TEXT={code} is your MandiMangoes login code. It expires in 5 minutes.
# How Jio's reply says the SMS was accepted, copied from Jio's API documentation
# (a dot path into the JSON reply, and the accepted values, comma separated).
# Required with SMS_PROVIDER=jio: an HTTP 200 alone does not count as sent.
JIO_SMS_SUCCESS_PATH=
JIO_SMS_SUCCESS_VALUES=
JIO_SMS_ID_PATH=
# sms or whatsapp: the first channel tried for login codes. Use whatsapp until Jio DLT is approved.
OTP_DEFAULT_CHANNEL=sms

# --- WhatsApp Cloud API (Meta). Leave WHATSAPP_PROVIDER=log until the templates are approved ---
WHATSAPP_PROVIDER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_PREFIX=mandi_
WHATSAPP_LANGUAGE=en
# Webhook https://<API_DOMAIN>/webhooks/whatsapp: the verify token you choose, and the app secret
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PAYMENT_CONFIG=
# Turn each on only after Meta approves the templates (mango-api/README.md, WhatsApp order updates):
# claim received / claim rejected messages, and the "Open order" button on the order update templates.
WHATSAPP_CLAIM_UPDATES=false
WHATSAPP_ORDER_LINKS=false

LOG_LEVEL=info

# --- Backups (deploy/README.md, Backups). Encrypted with deploy/backup-config/backup-public-key.asc ---
BACKUP_RETAIN_DAYS=14
# Copies each encrypted backup off this server; keep the single quotes. Until it is set, backups count as failed.
# Example: BACKUP_UPLOAD_CMD='/backup-config/rclone --config /backup-config/rclone.conf copy "$BACKUP_FILE" offsite:mandimangoes-backups'
BACKUP_UPLOAD_CMD=
