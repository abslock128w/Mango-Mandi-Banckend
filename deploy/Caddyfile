# HTTPS certificates are issued and renewed automatically for each domain.
{
	email {$ACME_EMAIL}
}

(security) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# A single-page app: unknown paths get index.html; hashed assets cache for a year.
(spa) {
	encode zstd gzip
	header X-Frame-Options DENY
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages not path /assets/*
	header @pages Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}

# The shop is a Next.js server (deploy/shop.Dockerfile); it sends its own CSP and frame headers.
{$SHOP_DOMAIN} {
	import security
	encode zstd gzip
	reverse_proxy shop:3001
}

www.{$SHOP_DOMAIN} {
	redir https://{$SHOP_DOMAIN}{uri} permanent
}

{$ADMIN_DOMAIN} {
	import security
	header X-Robots-Tag "noindex, nofollow"
	root * /srv/admin
	import spa
}

{$API_DOMAIN} {
	import security
	encode zstd gzip
	# Metrics stay inside the server (scrape api:3000/metrics).
	@metrics path /metrics
	respond @metrics 404
	reverse_proxy api:3000
}
