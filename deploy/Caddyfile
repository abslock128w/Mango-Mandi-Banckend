# HTTPS certificates are issued and renewed automatically for each domain.
{
	email {$ACME_EMAIL}
}

(security) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# A single-page app: unknown paths get index.html; hashed assets cache for a year.
(spa) {
	encode zstd gzip
	header X-Frame-Options DENY
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages not path /assets/*
	header @pages Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}

# The shop: the static files in shop/ (copied into the image by deploy/web.Dockerfile, with
# config.js written for this API). Headers and rewrites match shop/vercel.json, except that
# connect-src names this server's API domain.
{$SHOP_DOMAIN} {
	import security
	encode zstd gzip
	root * /srv/shop
	header {
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; script-src 'self' https://checkout.razorpay.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://{$API_DOMAIN} https://*.razorpay.com https://challenges.cloudflare.com; frame-src https://*.razorpay.com https://challenges.cloudflare.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://*.razorpay.com; frame-ancestors 'none'"
	}
	@fresh path /sw.js /config.js
	header @fresh Cache-Control "no-cache"
	@app path /preorders/* /order/* /orders/* /help/requests/* /account/* /invite/*
	rewrite @app /index.html
	file_server
}

www.{$SHOP_DOMAIN} {
	redir https://{$SHOP_DOMAIN}{uri} permanent
}

{$ADMIN_DOMAIN} {
	import security
	header X-Robots-Tag "noindex, nofollow"
	root * /srv/admin
	import spa
}

{$API_DOMAIN} {
	import security
	encode zstd gzip
	# Metrics stay inside the server (scrape api:3000/metrics).
	@metrics path /metrics
	respond @metrics 404
	reverse_proxy api:3000
}
