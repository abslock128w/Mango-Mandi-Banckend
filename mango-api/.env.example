# Copy to .env (or set in your host) and fill in. Production refuses to start with the dev defaults.
NODE_ENV=development
PORT=3000
# Address a long-running server listens on. Unset: every interface (Docker needs that).
# A local run on a shared Wi-Fi sets 127.0.0.1 so /v1/dev is not reachable from other devices.
HOST=
LOG_LEVEL=info
DATABASE_URL=postgres://mango:mango@localhost:5432/mango
# 32+ random characters in production: openssl rand -hex 32
JWT_SECRET=
# The admin panel's origin(s), comma-separated. Needed for the refresh cookie and CORS.
ADMIN_ORIGIN=http://localhost:5173
# The customer app's address (comma-separate several)
CUSTOMER_ORIGIN=http://localhost:5174
# false only for plain-http local development
COOKIE_SECURE=true
# Number of proxies in front of the API (for rate limits by client IP)
TRUST_PROXY=0
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Only while rotating the webhook secret: the old one, for a day.
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
# Optional bearer token for GET /metrics
METRICS_TOKEN=
# OTP delivery: log (development) or jio (required in production)
SMS_PROVIDER=log
# With SMS_PROVIDER=log, also write the codes to the log (a preview, say). Development gets them as devCode.
LOG_OTP_CODES=false
# Outside production the login code also comes back in the response (devCode). false keeps it
# out (scripts/start-local.mjs --phone does this, with LOG_OTP_CODES=true).
OTP_CODE_IN_RESPONSE=true
# Pepper for stored login-code hashes; unset uses JWT_SECRET. Codes already sent keep working.
OTP_PEPPER=
# Months after delivery that an order keeps the customer's name, phone and address (default 12).
PII_RETENTION_MONTHS=12
# Staff Google sign-in only for this Google Workspace domain (unset: any verified staff email).
STAFF_GOOGLE_HD=
# Local development only: /v1/dev routes that mark orders paid (the shop's test-mode pay buttons, e2e tests).
# Ignored in production and whenever Razorpay keys are set.
ENABLE_DEV_ROUTES=true
# Local development only: an unexpected error (500) also shows its cause in the panel. Ignored in production.
SHOW_ERROR_DETAILS=false
JIO_SMS_URL=
JIO_SMS_API_KEY=
# DLT registration: 6-character header, template ID and principal entity ID
JIO_SMS_SENDER_ID=
JIO_SMS_TEMPLATE_ID=
JIO_SMS_ENTITY_ID=
# Must match the DLT template exactly; {code} is replaced with the login code
JIO_SMS_TEXT={code} is your MandiMangoes login code. It expires in 5 minutes.
# How Jio's reply says the SMS was accepted, copied from Jio's API documentation
# (a dot path into the JSON reply, and the accepted values, comma separated).
# Required with SMS_PROVIDER=jio: an HTTP 200 alone does not count as sent.
JIO_SMS_SUCCESS_PATH=
JIO_SMS_SUCCESS_VALUES=
JIO_SMS_ID_PATH=
# sms or whatsapp: the first channel tried for login codes. Use whatsapp until Jio DLT is approved.
OTP_DEFAULT_CHANNEL=sms
# WhatsApp order updates: log (development) or meta (WhatsApp Cloud API)
WHATSAPP_PROVIDER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Approved templates are named prefix + kind, e.g. mandi_order_confirmed (see README)
WHATSAPP_TEMPLATE_PREFIX=mandi_
WHATSAPP_LANGUAGE=en
# Ordering in the chat: the webhook verify token you choose in the Meta app, and the app secret
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Optional: pay inside WhatsApp (Razorpay payment configuration name). Unset sends a Razorpay link.
# Keep it unset for now: there is no reconcile for WhatsApp payments yet (preflight warns).
WHATSAPP_PAYMENT_CONFIG=
# Turn each on only after Meta approves the templates (mango-api/README.md, WhatsApp order updates):
# claim received / claim rejected messages, and the "Open order" button on the order update templates.
WHATSAPP_CLAIM_UPDATES=false
WHATSAPP_ORDER_LINKS=false
# Demo batches on an empty database (never in production)
SEED_DEMO_DATA=true
# Production only: creates the first manager when there are no staff accounts
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Trust pack (docs/trust.md). Each switch is on outside production and off in production until set to true.
# Numbered bills for paid orders (PDF in the shop and the panel) and the business name and GSTIN at checkout.
BILLS_ENABLED=
# The panel's customer profile, phone search and audited phone reveal (managers and operators).
CUSTOMER_PROFILES_ENABLED=
# CSV exports for managers (orders, order lines, claims, reviews, Bulk Deals orders, payments, refunds).
STAFF_EXPORTS_ENABLED=
# The seller printed on every bill: required in production while BILLS_ENABLED=true (preflight stops the start).
BILL_SELLER_LEGAL_NAME=
# Address lines separated by "|", e.g. 12 Mandi Road|Bengaluru 560034
BILL_SELLER_ADDRESS=
# GST state code of the place of business, e.g. 29 for Karnataka
BILL_SELLER_STATE_CODE=
# Only once registered under GST: the bill becomes a Bill of Supply. Unset: a plain Receipt.
BILL_SELLER_GSTIN=
# Optional line under the seller, e.g. WhatsApp and email
BILL_SELLER_CONTACT=
# 1 to 3 letters or digits before the number (MM/26-27/000001)
BILL_NUMBER_PREFIX=MM
# Fixes from the 24 Oct 2026 audit, each off until set (docs/audit-2026-10-24-status-A.md):
# refund safety (PAY-05, PAY-06), the daily Razorpay payment check (PAY-08),
# order rules (INV-01, INV-07, INV-10) and stock intake checks (INV-02, INV-08).
REFUND_SAFETY_CHECKS=false
PAYMENT_DAILY_RECON=false
ORDER_RULE_CHECKS=false
STOCK_INTAKE_CHECKS=false
# With STOCK_INTAKE_CHECKS: the most boxes a non-manager may bring in with one batch
BATCH_INTAKE_MANAGER_BOXES=1000
# Fixes from the 24 Oct 2026 audit (security, integrations, platform; docs/audit-b-fixes.md).
# Each is off unless true; setting it back to false is the rollback.
# 4xx for bad requests (no 500 or Sentry event), 405 with Allow, retryAfterSeconds, CORS-exposed headers
API_HARDENING=false
# Stale-message skips, Meta error codes, login-code delivery checks, Blob timeouts and sweeps
PROVIDER_CHECKS=false
# Alerts that repeat while a problem lasts; dropped WhatsApp messages shown in Needs attention
OPS_ALERTS=false
# Out for delivery only on the delivery day; retries and replacements only promise real dates
DELIVERY_CHECKS=false
# Staff changes ask the manager for their two-step code (or password) again
STAFF_STEP_UP=false
# Staff changes audited in their own transaction; views of customer details and refusals recorded
STAFF_AUDIT_TRAIL=false
# Customer care (docs/care.md). Each is off unless true.
# Help centre: help requests from an order page or /help, and the panel's Help desk
HELP_CENTRE=false
# New help requests a customer may open in 24 hours (replies to one don't count)
HELP_DAILY_LIMIT=5
# Mango season subscriptions: a box every week or fortnight, paid for each time (no auto-debit, no wallet)
SUBSCRIPTIONS=false
# Last day a subscription can run (YYYY-MM-DD). Unset or past: no new subscriptions start.
SUBSCRIPTION_SEASON_END=
# Days ahead of each delivery that its box is set up and the customer asked to pay (1 to 5)
SUBSCRIPTION_LEAD_DAYS=2
# WhatsApp for help replies (mandi_help_reply) and pay reminders (mandi_subscription_due).
# New templates: needs Meta approval first. Web push goes out without it when WEB_PUSH is on.
WHATSAPP_CARE_UPDATES=false
