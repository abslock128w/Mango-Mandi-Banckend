{
  "name": "mango-admin",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests && npm --prefix customer-app run typecheck",
    "test:e2e": "playwright test",
    "test:unit": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"tests/unit/*.unit.ts\"",
    "lint": "eslint . && npm --prefix customer-app run lint",
    "scan:bundle": "node scripts/scan-bundle.mjs dist customer-app/.next/static",
    "shop:dev": "npm --prefix customer-app run dev -- --port 5174",
    "shop:build": "npm --prefix customer-app run build",
    "shop:preview": "npm --prefix customer-app run start -- --port 5174",
    "shop:install": "npm --prefix customer-app ci",
    "shop:test": "npm --prefix customer-app test"
  },
  "dependencies": {
    "@sentry/browser": "11.7.0",
    "@tanstack/react-query": "^5.56.2",
    "@vercel/blob": "^2.8.2",
    "lucide-react": "^1.64.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.47.2",
    "@sentry/vite-plugin": "5.4.1",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.5.3",
    "vite": "^6.4.5"
  },
  "overrides": {
    "zod": "^4.6.7",
    "@sentry/bundler-plugins": "10.76.2"
  }
}
