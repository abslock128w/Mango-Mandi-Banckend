{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node build-config.mjs",
  "outputDirectory": ".",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/((?!one-mango/).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://checkout.razorpay.com https://challenges.cloudflare.com https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://nominatim.openstreetmap.org https://api.mandimangoes.in https://mandi-api-staging.vercel.app https://*.razorpay.com https://challenges.cloudflare.com https://maps.googleapis.com https://places.googleapis.com https://maps.gstatic.com; frame-src 'self' https://*.razorpay.com https://challenges.cloudflare.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://*.razorpay.com; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/one-mango/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://checkout.razorpay.com https://challenges.cloudflare.com https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://nominatim.openstreetmap.org https://api.mandimangoes.in https://mandi-api-staging.vercel.app https://*.razorpay.com https://challenges.cloudflare.com https://maps.googleapis.com https://places.googleapis.com https://maps.gstatic.com; frame-src 'self' https://*.razorpay.com https://challenges.cloudflare.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://*.razorpay.com; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/(sw\\.js|config\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/preorder",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/legacy/story",
      "destination": "/legacy",
      "permanent": false
    },
    {
      "source": "/legacy/story/",
      "destination": "/legacy",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://mandi-api-staging.vercel.app/v1/:path*"
    },
    {
      "source": "/robots.txt",
      "destination": "/_routes/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/_routes/sitemap.xml"
    },
    {
      "source": "/bulk{/}?",
      "destination": "/_routes/bulk.html"
    },
    {
      "source": "/gifts{/}?",
      "destination": "/_routes/gifts.html"
    },
    {
      "source": "/partner{/}?",
      "destination": "/_routes/partner.html"
    },
    {
      "source": "/legacy{/}?",
      "destination": "/_routes/legacy.html"
    },
    {
      "source": "/help{/}?",
      "destination": "/_routes/help.html"
    },
    {
      "source": "/contact{/}?",
      "destination": "/_routes/contact.html"
    },
    {
      "source": "/farm-experience{/}?",
      "destination": "/_routes/farm-experience.html"
    },
    {
      "source": "/privacy{/}?",
      "destination": "/_routes/privacy.html"
    },
    {
      "source": "/terms{/}?",
      "destination": "/_routes/terms.html"
    },
    {
      "source": "/refund{/}?",
      "destination": "/_routes/refund.html"
    },
    {
      "source": "/shipping{/}?",
      "destination": "/_routes/shipping.html"
    },
    {
      "source": "/login{/}?",
      "destination": "/index.html"
    },
    {
      "source": "/account/:path*{/}?",
      "destination": "/index.html"
    },
    {
      "source": "/orders{/}?",
      "destination": "/index.html"
    },
    {
      "source": "/orders/:id{/}?",
      "destination": "/index.html"
    },
    {
      "source": "/order/:id{/}?",
      "destination": "/index.html"
    },
    {
      "source": "/cart{/}?",
      "destination": "/index.html"
    },
    {
      "source": "/checkout{/}?",
      "destination": "/index.html"
    },
    {
      "source": "/preorders/:id{/}?",
      "destination": "/index.html"
    },
    {
      "source": "/invite/:code{/}?",
      "destination": "/index.html"
    },
    {
      "source": "/help/requests/:id{/}?",
      "destination": "/index.html"
    },
    {
      "source": "/bulk/:tab(enquiry|farm-visit){/}?",
      "destination": "/index.html"
    },
    {
      "source": "/bulk/orders/:id{/}?",
      "destination": "/index.html"
    },
    {
      "source": "/gifts/:id{/}?",
      "destination": "/index.html"
    },
    {
      "source": "/gifts/send/review{/}?",
      "destination": "/index.html"
    },
    {
      "source": "/partner/:page(apply|privacy){/}?",
      "destination": "/index.html"
    },
    {
      "source": "/legacy/film{/}?",
      "destination": "/index.html"
    },
    {
      "source": "/farm-experience/book{/}?",
      "destination": "/index.html"
    },
    {
      "source": "/farm-bookings{/}?",
      "destination": "/index.html"
    },
    {
      "source": "/farm-bookings/:id{/}?",
      "destination": "/index.html"
    }
  ]
}
